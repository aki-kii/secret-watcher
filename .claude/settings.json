{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *pr *create*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/review/review.mjs\" gate || exit 2",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(gh *pr *new*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/review/review.mjs\" gate || exit 2",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" reset"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
